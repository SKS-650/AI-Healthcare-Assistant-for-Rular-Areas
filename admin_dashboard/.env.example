# ═══════════════════════════════════════════════════════════════════════════
# AI Healthcare Assistant - Admin Dashboard Environment Configuration (EXAMPLE)
# ═══════════════════════════════════════════════════════════════════════════
# 
# 🔧 SETUP INSTRUCTIONS:
# 1. Copy this file to .env (in the same directory)
# 2. Update BACKEND_URL with your computer's IP address
# 3. Save and restart the dashboard
# 
# ═══════════════════════════════════════════════════════════════════════════

# Backend Server Configuration
# Format: http://<YOUR_IP_ADDRESS>:<PORT>
# 
# How to find your IP address:
#   Windows:  Run `ipconfig` in Command Prompt → look for "IPv4 Address"
#   Mac:      Run `ifconfig` in Terminal → look for "inet" under WiFi adapter
#   Linux:    Run `ip addr` or `hostname -I`
# 
# Examples:
#   - For same WiFi network: http://192.168.1.100:8000
#   - For mobile hotspot:    http://192.168.137.1:8000
#   - For localhost:         http://localhost:8000
BACKEND_URL=http://192.168.1.100:8000

# Backend Port (default: 8000)
BACKEND_PORT=8000

# API Version
API_VERSION=v1

# ═══════════════════════════════════════════════════════════════════════════
# 📝 NOTES:
# - Replace the example IP (192.168.1.100) with YOUR computer's actual IP
# - For web development, you can use http://localhost:8000
# - When you switch WiFi networks, just update this file and restart
# - The backend server must be running on port 8000
# ═══════════════════════════════════════════════════════════════════════════
